DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/healthtrack
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
FRONTEND_URL=http://localhost:5173
# Local Gmail SMTP. Render Free must use the Brevo HTTPS option below.
MAIL_PROVIDER=gmail
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password

# Render Free: set MAIL_PROVIDER=brevo, verify the sender in Brevo,
# and set these secrets in the Render backend service's Environment settings.
MAIL_FROM_EMAIL=
BREVO_API_KEY=

# Staff portals (admin/health_worker) hide behind this shared access key.
# Patient stays public. Set a distinct long random value per staff service on
# Render; production staff services refuse to start without it.
STAFF_SITE_KEY=
