{
  "name": "healthtrack-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "local-db": "node src/scripts/local-db.js",
    "dev": "nodemon src/server.js",
    "dev:admin": "nodemon src/scripts/start-portal.js admin",
    "dev:health-worker": "nodemon src/scripts/start-portal.js health-worker",
    "start": "node src/server.js",
    "start:admin": "node src/scripts/start-portal.js admin",
    "start:health-worker": "node src/scripts/start-portal.js health-worker",
    "seed": "node src/scripts/seed.js",
    "sync-schema": "node -e \"import('./src/config/db.js').then(m => m.syncSchema())\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.3",
    "healthtrack": "file:..",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "embedded-postgres": "^18.6.0-beta.19",
    "nodemon": "^3.1.7"
  }
}
